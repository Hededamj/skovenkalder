# Skoven Kalder – Apache-konfiguration til Simply-webhotellet.
# Modsvarer vercel.json (headers + cache). Statisk site: ingen PHP.

DirectoryIndex index.html
Options -Indexes +FollowSymLinks

# Ingen adgang til dotfiles (fx .ftp-deploy-sync-state.json)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\." - [F]

  # www -> apex
  RewriteCond %{HTTP_HOST} ^www\.skovenkalder\.se$ [NC]
  RewriteRule ^(.*)$ https://skovenkalder.se/$1 [R=301,L]

  # http -> https. AKTIVÉR FØRST når SSL er slået til i Simply-panelet,
  # ellers redirecter siden til en port, der ikke svarer.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://skovenkalder.se/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Billeder: cache et døgn, servér gammel kopi mens ny hentes
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # Kalender-status og HTML skal altid være friske
  <FilesMatch "^(booking-status\.json|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/webp .webp
  AddType image/avif .avif
  AddCharset utf-8 .html .json .xml .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
